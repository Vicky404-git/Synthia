# =============================================================================
# Synthia backend configuration — copy to .env and fill in what you have.
# NEVER commit a real .env, key, or token. Placeholders only.
# =============================================================================

# --- Core ---
APP_ENV=development
PORT=8000
DEMO_MODE=true
# Comma-separated list. Add your production frontend origin when deployed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional bearer token required for cloud tool operations and server history.
# Leave empty for local development. Set a strong value for a public demo.
API_AUTH_TOKEN=
# V1 defaults to read-only cloud tools. Set true only to demo mutating flows.
ALLOW_MUTATING=false
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_CHARS=8000
MAX_LOG_LINES=200

# --- LLM (replaceable, OpenAI-compatible) ---
# demo = built-in offline provider (no key needed). openai = hosted API.
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Change for Groq/OpenRouter/other OpenAI-compatible endpoints.
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=800

# --- Server-side speech-to-text (default recogniser in the frontend) ---
# none = disabled, faster-whisper = local CPU inference (recommended),
# openai = hosted Whisper-compatible endpoint.
STT_PROVIDER=faster-whisper
# Model for the selected provider: a local size (tiny|base|small|medium|large-v3)
# for faster-whisper, or a hosted name (whisper-1) for openai.
STT_MODEL=base
# Only needed for the hosted provider.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_TIMEOUT_SECONDS=60
STT_MAX_UPLOAD_BYTES=10485760
# --- Local Faster-Whisper only ---
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=0
STT_BEAM_SIZE=1
STT_VAD_FILTER=true
# Model cache location. Keep it OUTSIDE the repository. Defaults to the user
# cache dir when unset. First run downloads the model (needs internet).
STT_CACHE_DIR=
# Local inference (and the first model download) can be slow on CPU.
STT_LOCAL_TIMEOUT_SECONDS=300

# --- AWS (read-only, first real cloud integration) ---
AWS_ENABLED=false
AWS_DEFAULT_REGION=us-east-1
# Prefer an IAM role or short-lived credentials. Otherwise export the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (and optional AWS_SESSION_TOKEN).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Minimal read-only IAM policy example:
#   ec2:DescribeInstances, s3:ListAllMyBuckets

# --- Docker (local demonstration only; do NOT expose the socket publicly) ---
DOCKER_ENABLED=false
DOCKER_SOCKET=unix:///var/run/docker.sock

# --- Azure (interface only in V1; not implemented/verified) ---
AZURE_ENABLED=false
AZURE_SUBSCRIPTION_ID=

# =============================================================================
# Frontend (build-time; see frontend/.env.example)
# =============================================================================
# VITE_API_BASE_URL=https://your-backend.example.com
# VITE_STT_PROVIDER=server
# The API token is entered at runtime in Settings (sessionStorage), not here.
