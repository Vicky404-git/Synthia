# Frontend build-time configuration.
# Copy to .env (or provide these in your hosting provider's build settings).

# Base URL of the Synthia backend, e.g. https://synthia-api.onrender.com
# Leave empty for local development (the Vite dev server proxies to localhost:8000).
VITE_API_BASE_URL=

# Which speech recogniser to use: server | browser
# "server" (recommended, default) records audio and posts it to the backend,
# which transcribes it with local Faster-Whisper by default. Audio leaves the
# device but stays on your backend host.
# "browser" uses the Web Speech API — some browsers send audio to a vendor
# service, and it frequently fails with a network error.
VITE_STT_PROVIDER=server

# NOTE: the API token is NOT a build-time variable. It is entered at runtime in
# the Settings page and kept in sessionStorage for the current session only, so
# it is never baked into the JavaScript bundle.
